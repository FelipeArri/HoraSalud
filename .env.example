# Copiar este archivo como ".env" (junto a manage.py) y completar los valores.
# El archivo .env NUNCA se sube a Git (RNF-SEC02).

# Clave secreta de Django. Generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=pegar_aqui_la_clave_generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos MySQL/MariaDB de XAMPP (SRC03-C05)
DB_NAME=horasalud_db
DB_USER=horasalud_app
DB_PASSWORD=cambiar_esta_clave
DB_HOST=127.0.0.1
DB_PORT=3306

# B-16: dominio del tunel de VS Code (pestana PORTS) para usar la huella del telefono.
# Dejar vacio si no se usa. Ej.: HORASALUD_DOMINIO_PUBLICO=abc123-8000.brs.devtunnels.ms
HORASALUD_DOMINIO_PUBLICO=
